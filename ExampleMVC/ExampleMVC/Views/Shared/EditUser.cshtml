@model Service.ViewModels.AccountViewModel
@{
    if (!"Home".Equals(ViewBag.Controller))
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    ViewBag.Title = "Edit User";
}

<div class="container-fluid mt-5">
    <div class="row">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-3 text-center p-4 mb-4">
                <div class="card-body">
                    <div class="mb-3">
                        <div class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center text-white shadow-sm" style="width: 100px; height: 100px; font-size: 40px;">
                            <i class="fa fa-user"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-1">@Model.Email</h5>
                    <p class="text-muted small">@Model.Role</p>
                    <div class="badge bg-light text-success border border-success px-3 py-2 rounded-pill">Active Account</div>
                </div>
                <hr class="text-muted">
                <div class="text-start px-3">
                    <p class="small text-muted mb-1"><i class="fa fa-calendar-alt me-2"></i>Last login: 2 hours ago</p>
                    <p class="small text-muted"><i class="fa fa-shield-alt me-2"></i>Security Level: High</p>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h4 class="card-title fw-bold text-primary mb-0">Account Settings</h4>
                    <p class="text-muted small">Update user information and access levels.</p>
                </div>

                <div class="card-body p-4">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.Id)

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger p-2 mb-3 rounded" })

                        <div class="row mb-3">
                            <div class="col-md-6">
                                @Html.LabelFor(model => model.Email, "Email Address", htmlAttributes: new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control bg-light" } })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(model => model.Role, "System Role", htmlAttributes: new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(model => model.Role, new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "Administrator", Value = "Admin" },
                                    new SelectListItem { Text = "Manager", Value = "Manager" },
                                    new SelectListItem { Text = "Standard User", Value = "User" }
                                }, "Select Role", new { @class = "form-select form-control-lg" })
                                @Html.ValidationMessageFor(model => model.Role, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Password, "Password", htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control", type = "password" } })
                            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger small" })
                        </div>

                        <hr class="text-muted mb-4" />

                        <div class="d-flex justify-content-end align-items-center gap-2">
                            @if (!"Home".Equals(ViewBag.Controller))
                            {
                                <a href="@Url.Action("ListUser")" class="btn btn-outline-secondary px-4 py-2">
                                    Cancel
                                </a>
                            }
                            else
                            {
                                <a href="/" class="btn btn-outline-secondary px-4 py-2">
                                    Cancel
                                </a>
                            }
                            <button type="submit" class="btn btn-primary px-5 py-2 shadow-sm fw-bold">
                                Save Changes
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}