@model Service.ViewModels.MotorViewModel

@{
    if (!"Showroom".Equals(ViewBag.ReturnTitle))
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }

    ViewBag.Title = "Motor Detail";
}

<nav aria-label="breadcrumb" class="pt-2">
    <ol class="breadcrumb">
        @if ("Showroom".Equals(ViewBag.ReturnTitle))
        {
            <li class="breadcrumb-item"><a href="@Url.Action("Showroom", "Home")">@ViewBag.ReturnTitle</a></li>
        }
        else
        {
            <li class="breadcrumb-item"><a href="@Url.Action("ListMotor", "Admin")">@ViewBag.ReturnTitle</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">@Html.DisplayFor(m => m.Name)</li>
    </ol>
</nav>
<hr />

<div class="container mt-5">
    <div class="row">
        <!-- Product Images -->
        <div class="col-md-6 mb-4">
            @if (string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="~/wwwroot/icons/black-moto.png" alt="motor image" class="w-50 img-fluid rounded mb-3" />
            }
            else
            {
                <img src="@Html.DisplayFor(model => model.ImageUrl)" alt="motor image" class="w-100 img-fluid rounded mb-3" />
            }
        </div>

        <!-- Product Details -->
        <div class="col-md-6">
            <h2 class="mb-3">@Html.DisplayFor(model => model.Name)</h2>
            <p class="text-muted mb-4">SKU: MM@{@Html.DisplayFor(model => model.Id)}</p>
            <div class="mb-3">
                <span class="h4 me-2">@Html.DisplayFor(model => model.Price) VND</span>
                <span class="text-muted">
                    @{ var money = @Model.Price + 40000000;
                        <s>@money.ToString("0#,##0") VND</s>
                    }
                </span>
            </div>
            <div class="mb-3">
                <i class="text-warning">*</i>
                <i class="text-warning">*</i>
                <i class="text-warning">*</i>
                <i class="text-warning">*</i>
                <i class="text-warning">*</i>
                <span class="ms-2">4.5 (120 reviews)</span>
            </div>
            <p class="mb-4">
                @Html.DisplayFor(model => model.Description)
            </p>
            <div class="mb-4">
                <h5>Color:</h5>
                <div class="btn-group" role="group" aria-label="Color selection">
                    <input type="radio" class="btn-check" name="color" id="black" autocomplete="off" checked>
                    <label class="btn btn-outline-dark" for="black">Black</label>
                    <input type="radio" class="btn-check" name="color" id="white" autocomplete="off">
                    <label class="btn btn-outline-secondary" for="white">White</label>
                    <input type="radio" class="btn-check" name="color" id="red" autocomplete="off">
                    <label class="btn btn-outline-danger" for="red">Red</label>
                </div>
            </div>
            <div class="mb-4">
                <label for="quantity" class="form-label">Quantity:</label>
                <input type="number" class="form-control" id="quantity" value="1" min="1" style="width: 80px;">
            </div>
            <button class="btn btn-primary btn-lg mb-3 me-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-cart-fill" viewBox="0 0 16 16">
                    <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2" />
                </svg> Add to Cart
            </button>
            <button class="btn btn-outline-secondary btn-lg mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-bag-heart-fill" viewBox="0 0 16 16">
                    <path d="M11.5 4v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4zM8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1m0 6.993c1.664-1.711 5.825 1.283 0 5.132-5.825-3.85-1.664-6.843 0-5.132" />
                </svg> Add to Wishlist
            </button>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
