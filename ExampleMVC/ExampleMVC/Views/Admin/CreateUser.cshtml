@model Service.ViewModels.AccountViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Create User";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h4 class="card-title fw-bold text-primary">@ViewBag.Title</h4>
                    <p class="text-muted small">Please fill all the fields in the form.</p>
                </div>

                <div class="card-body p-4">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger p-2 mb-3 rounded" })

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Email, "Email", htmlAttributes: new { @class = "form-label fw-bold text-dark" })
                            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "example@domain.com", type = "email" } })
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Password, "Password", htmlAttributes: new { @class = "form-label fw-bold text-dark" })
                            @Html.PasswordFor(model => model.Password, new { @class = "form-control form-control-lg", placeholder = "Enter password" })
                            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(model => model.Role, "Role", htmlAttributes: new { @class = "form-label fw-bold text-dark" })
                            @Html.EditorFor(model => model.Role, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "e.g., Admin, Manager, User" } })
                            @Html.ValidationMessageFor(model => model.Role, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <hr class="text-muted mb-4" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a href="@Url.Action("ListUser")" class="btn btn-light border px-4 py-2">
                                Return to List
                            </a>
                            <button type="submit" class="btn btn-primary px-5 py-2 shadow-sm fw-bold">
                                Save
                            </button>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}